# Copy to .env and fill in. Never commit .env (SEC-05).

# Database (Docker Compose / Kubernetes use PostgreSQL)
POSTGRES_USER=reqtrace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reqtrace
DATABASE_URL=postgresql+psycopg://reqtrace:change-me@db:5432/reqtrace

# Auth
JWT_SECRET=generate-a-long-random-string
SESSION_MINUTES=60

# LLM: "gemini" for real generation, "mock" for offline demo and tests, "offline" to simulate an outage
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview,gemini-3.1-flash-lite

# Initial Administrator, created at start-up (admins cannot self-register)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
